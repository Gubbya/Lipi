  "units": [
    { "id": "en-letter-a", "languageId": "en", "scriptId": "latin", "type": "letter", "symbol": "A a", "displayName": "Letter A", "transliteration": "ay", "soundHint": "short a /æ/", "speechCue": "A says ah, as in apple. Apple.", "exampleWords": ["apple", "ant", "map"] },
    { "id": "en-letter-b", "languageId": "en", "scriptId": "latin", "type": "letter", "symbol": "B b", "displayName": "Letter B", "transliteration": "bee", "soundHint": "/b/", "speechCue": "B says buh, as in ball. Ball.", "exampleWords": ["ball", "book", "cab"] },
    { "id": "en-letter-c", "languageId": "en", "scriptId": "latin", "type": "letter", "symbol": "C c", "displayName": "Letter C", "transliteration": "see", "soundHint": "hard c /k/", "speechCue": "C says kuh, as in cat. Cat.", "exampleWords": ["cat", "cup", "can"] },
    { "id": "en-letter-d", "languageId": "en", "scriptId": "latin", "type": "letter", "symbol": "D d", "displayName": "Letter D", "transliteration": "dee", "soundHint": "/d/", "speechCue": "D says duh, as in dog. Dog.", "exampleWords": ["dog", "door", "red"] },
    { "id": "en-letter-e", "languageId": "en", "scriptId": "latin", "type": "letter", "symbol": "E e", "displayName": "Letter E", "transliteration": "ee", "soundHint": "short e /ɛ/", "speechCue": "E says eh, as in egg. Egg.", "exampleWords": ["egg", "end", "bed"] },
    { "id": "en-letter-f", "languageId": "en", "scriptId": "latin", "type": "letter", "symbol": "F f", "displayName": "Letter F", "transliteration": "ef", "soundHint": "/f/", "speechCue": "F says fff, as in fish. Fish.", "exampleWords": ["fish", "fan", "leaf"] },
    { "id": "en-letter-g", "languageId": "en", "scriptId": "latin", "type": "letter", "symbol": "G g", "displayName": "Letter G", "transliteration": "jee", "soundHint": "hard g /g/", "speechCue": "G says guh, as in goat. Goat.", "exampleWords": ["goat", "gum", "bag"] },
    { "id": "en-letter-h", "languageId": "en", "scriptId": "latin", "type": "letter", "symbol": "H h", "displayName": "Letter H", "transliteration": "aitch", "soundHint": "/h/", "speechCue": "H says huh, as in hat. Hat.", "exampleWords": ["hat", "hen", "home"] },
    { "id": "en-letter-i", "languageId": "en", "scriptId": "latin", "type": "letter", "symbol": "I i", "displayName": "Letter I", "transliteration": "eye", "soundHint": "short i /ɪ/", "speechCue": "I says ih, as in ink. Ink.", "exampleWords": ["ink", "in", "sit"] },
    { "id": "en-letter-j", "languageId": "en", "scriptId": "latin", "type": "letter", "symbol": "J j", "displayName": "Letter J", "transliteration": "jay", "soundHint": "/dʒ/", "speechCue": "J says juh, as in jam. Jam.", "exampleWords": ["jam", "jet", "jog"] },
    { "id": "en-letter-k", "languageId": "en", "scriptId": "latin", "type": "letter", "symbol": "K k", "displayName": "Letter K", "transliteration": "kay", "soundHint": "/k/", "speechCue": "K says kuh, as in kite. Kite.", "exampleWords": ["kite", "kid", "king"] },
    { "id": "en-letter-l", "languageId": "en", "scriptId": "latin", "type": "letter", "symbol": "L l", "displayName": "Letter L", "transliteration": "el", "soundHint": "/l/", "speechCue": "L says lll, as in lion. Lion.", "exampleWords": ["lion", "leg", "bell"] },
    { "id": "en-letter-m", "languageId": "en", "scriptId": "latin", "type": "letter", "symbol": "M m", "displayName": "Letter M", "transliteration": "em", "soundHint": "/m/", "speechCue": "M says mmm, as in moon. Moon.", "exampleWords": ["moon", "map", "ham"] },
    { "id": "en-letter-n", "languageId": "en", "scriptId": "latin", "type": "letter", "symbol": "N n", "displayName": "Letter N", "transliteration": "en", "soundHint": "/n/", "speechCue": "N says nnn, as in nest. Nest.", "exampleWords": ["nest", "net", "sun"] },
    { "id": "en-letter-o", "languageId": "en", "scriptId": "latin", "type": "letter", "symbol": "O o", "displayName": "Letter O", "transliteration": "oh", "soundHint": "short o /ɒ/", "speechCue": "O says aw, as in octopus. Octopus.", "exampleWords": ["octopus", "on", "hot"] },
    { "id": "en-letter-p", "languageId": "en", "scriptId": "latin", "type": "letter", "symbol": "P p", "displayName": "Letter P", "transliteration": "pee", "soundHint": "/p/", "speechCue": "P says puh, as in pig. Pig.", "exampleWords": ["pig", "pen", "cap"] },
    { "id": "en-letter-q", "languageId": "en", "scriptId": "latin", "type": "letter", "symbol": "Q q", "displayName": "Letter Q", "transliteration": "cue", "soundHint": "/kw/", "speechCue": "Q and U say kwuh, as in queen. Queen.", "exampleWords": ["queen", "quick", "quiz"] },
    { "id": "en-letter-r", "languageId": "en", "scriptId": "latin", "type": "letter", "symbol": "R r", "displayName": "Letter R", "transliteration": "ar", "soundHint": "/r/", "speechCue": "R says rrr, as in rabbit. Rabbit.", "exampleWords": ["rabbit", "red", "run"] },
    { "id": "en-letter-s", "languageId": "en", "scriptId": "latin", "type": "letter", "symbol": "S s", "displayName": "Letter S", "transliteration": "ess", "soundHint": "/s/", "speechCue": "S says sss, as in sun. Sun.", "exampleWords": ["sun", "sock", "bus"] },
    { "id": "en-letter-t", "languageId": "en", "scriptId": "latin", "type": "letter", "symbol": "T t", "displayName": "Letter T", "transliteration": "tee", "soundHint": "/t/", "speechCue": "T says tuh, as in top. Top.", "exampleWords": ["top", "ten", "cat"] },
    { "id": "en-letter-u", "languageId": "en", "scriptId": "latin", "type": "letter", "symbol": "U u", "displayName": "Letter U", "transliteration": "you", "soundHint": "short u /ʌ/", "speechCue": "U says uh, as in umbrella. Umbrella.", "exampleWords": ["umbrella", "up", "sun"] },
    { "id": "en-letter-v", "languageId": "en", "scriptId": "latin", "type": "letter", "symbol": "V v", "displayName": "Letter V", "transliteration": "vee", "soundHint": "/v/", "speechCue": "V says vvv, as in van. Van.", "exampleWords": ["van", "vet", "five"] },
    { "id": "en-letter-w", "languageId": "en", "scriptId": "latin", "type": "letter", "symbol": "W w", "displayName": "Letter W", "transliteration": "double you", "soundHint": "/w/", "speechCue": "W says wuh, as in web. Web.", "exampleWords": ["web", "win", "water"] },
    { "id": "en-letter-x", "languageId": "en", "scriptId": "latin", "type": "letter", "symbol": "X x", "displayName": "Letter X", "transliteration": "ex", "soundHint": "/ks/", "speechCue": "X says ks, as at the end of fox. Fox.", "exampleWords": ["fox", "box", "six"] },
    { "id": "en-letter-y", "languageId": "en", "scriptId": "latin", "type": "letter", "symbol": "Y y", "displayName": "Letter Y", "transliteration": "why", "soundHint": "/j/", "speechCue": "Y says yuh, as in yellow. Yellow.", "exampleWords": ["yellow", "yes", "yam"] },
    { "id": "en-letter-z", "languageId": "en", "scriptId": "latin", "type": "letter", "symbol": "Z z", "displayName": "Letter Z", "transliteration": "zee or zed", "soundHint": "/z/", "speechCue": "Z says zzz, as in zebra. Zebra.", "exampleWords": ["zebra", "zip", "zoo"] },

    { "id": "en-grapheme-ch", "languageId": "en", "scriptId": "latin", "type": "grapheme", "symbol": "ch", "displayName": "The CH sound", "transliteration": "ch", "soundHint": "/tʃ/", "speechCue": "C H says ch, as in chip. Chip, chair, lunch.", "exampleWords": ["chip", "chair", "lunch"] },
    { "id": "en-grapheme-sh", "languageId": "en", "scriptId": "latin", "type": "grapheme", "symbol": "sh", "displayName": "The SH sound", "transliteration": "sh", "soundHint": "/ʃ/", "speechCue": "S H says shhh, as in ship. Ship, shop, fish.", "exampleWords": ["ship", "shop", "fish"] },
    { "id": "en-grapheme-th", "languageId": "en", "scriptId": "latin", "type": "grapheme", "symbol": "th", "displayName": "The TH sound", "transliteration": "th", "soundHint": "/θ/ or /ð/", "speechCue": "T H says th, as in thin and this. Thin. This.", "exampleWords": ["thin", "this", "bath"] },
    { "id": "en-grapheme-wh", "languageId": "en", "scriptId": "latin", "type": "grapheme", "symbol": "wh", "displayName": "The WH sound", "transliteration": "wh", "soundHint": "/w/", "speechCue": "W H says wuh, as in wheel. Wheel, when, white.", "exampleWords": ["wheel", "when", "white"] },
    { "id": "en-grapheme-ng", "languageId": "en", "scriptId": "latin", "type": "grapheme", "symbol": "ng", "displayName": "The NG sound", "transliteration": "ng", "soundHint": "/ŋ/", "speechCue": "N G says ng, as at the end of ring. Ring, sing, long.", "exampleWords": ["ring", "sing", "long"] },
    { "id": "en-grapheme-ck", "languageId": "en", "scriptId": "latin", "type": "grapheme", "symbol": "ck", "displayName": "The CK sound", "transliteration": "ck", "soundHint": "/k/", "speechCue": "C K says kuh, as at the end of duck. Duck, sock, black.", "exampleWords": ["duck", "sock", "black"] },

    { "id": "en-grapheme-ai", "languageId": "en", "scriptId": "latin", "type": "grapheme", "symbol": "ai", "displayName": "The AI sound", "transliteration": "long a", "soundHint": "/eɪ/", "speechCue": "A I says ay, as in rain. Rain, train, paint.", "exampleWords": ["rain", "train", "paint"] },
    { "id": "en-grapheme-ay", "languageId": "en", "scriptId": "latin", "type": "grapheme", "symbol": "ay", "displayName": "The AY sound", "transliteration": "long a", "soundHint": "/eɪ/", "speechCue": "A Y says ay, as in play. Play, day, tray.", "exampleWords": ["play", "day", "tray"] },
    { "id": "en-grapheme-ee", "languageId": "en", "scriptId": "latin", "type": "grapheme", "symbol": "ee", "displayName": "The EE sound", "transliteration": "long e", "soundHint": "/iː/", "speechCue": "E E says ee, as in tree. Tree, green, feet.", "exampleWords": ["tree", "green", "feet"] },
    { "id": "en-grapheme-ea", "languageId": "en", "scriptId": "latin", "type": "grapheme", "symbol": "ea", "displayName": "The EA sound", "transliteration": "long e", "soundHint": "/iː/", "speechCue": "E A says ee, as in beach. Beach, leaf, read.", "exampleWords": ["beach", "leaf", "read"] },
    { "id": "en-grapheme-igh", "languageId": "en", "scriptId": "latin", "type": "grapheme", "symbol": "igh", "displayName": "The IGH sound", "transliteration": "long i", "soundHint": "/aɪ/", "speechCue": "I G H says eye, as in light. Light, night, high.", "exampleWords": ["light", "night", "high"] },
    { "id": "en-grapheme-oa", "languageId": "en", "scriptId": "latin", "type": "grapheme", "symbol": "oa", "displayName": "The OA sound", "transliteration": "long o", "soundHint": "/oʊ/", "speechCue": "O A says oh, as in boat. Boat, coat, road.", "exampleWords": ["boat", "coat", "road"] },
    { "id": "en-grapheme-oo", "languageId": "en", "scriptId": "latin", "type": "grapheme", "symbol": "oo", "displayName": "The OO sound", "transliteration": "oo", "soundHint": "/uː/ or /ʊ/", "speechCue": "O O says oo, as in moon, and sometimes uh, as in book. Moon. Book.", "exampleWords": ["moon", "food", "book"] },

    { "id": "en-grapheme-ou", "languageId": "en", "scriptId": "latin", "type": "grapheme", "symbol": "ou", "displayName": "The OU sound", "transliteration": "ow", "soundHint": "/aʊ/", "speechCue": "O U says ow, as in cloud. Cloud, out, house.", "exampleWords": ["cloud", "out", "house"] },
    { "id": "en-grapheme-ow", "languageId": "en", "scriptId": "latin", "type": "grapheme", "symbol": "ow", "displayName": "The OW sound", "transliteration": "ow", "soundHint": "/aʊ/", "speechCue": "O W says ow, as in cow. Cow, now, town.", "exampleWords": ["cow", "now", "town"] },
    { "id": "en-grapheme-oi", "languageId": "en", "scriptId": "latin", "type": "grapheme", "symbol": "oi", "displayName": "The OI sound", "transliteration": "oy", "soundHint": "/ɔɪ/", "speechCue": "O I says oy, as in coin. Coin, soil, point.", "exampleWords": ["coin", "soil", "point"] },
    { "id": "en-grapheme-oy", "languageId": "en", "scriptId": "latin", "type": "grapheme", "symbol": "oy", "displayName": "The OY sound", "transliteration": "oy", "soundHint": "/ɔɪ/", "speechCue": "O Y says oy, as in boy. Boy, toy, enjoy.", "exampleWords": ["boy", "toy", "enjoy"] },
    { "id": "en-grapheme-aw", "languageId": "en", "scriptId": "latin", "type": "grapheme", "symbol": "aw", "displayName": "The AW sound", "transliteration": "aw", "soundHint": "/ɔː/", "speechCue": "A W says aw, as in saw. Saw, paw, yawn.", "exampleWords": ["saw", "paw", "yawn"] },
    { "id": "en-grapheme-au", "languageId": "en", "scriptId": "latin", "type": "grapheme", "symbol": "au", "displayName": "The AU sound", "transliteration": "aw", "soundHint": "/ɔː/", "speechCue": "A U says aw, as in August. August, sauce, pause.", "exampleWords": ["August", "sauce", "pause"] },

    { "id": "en-grapheme-ar", "languageId": "en", "scriptId": "latin", "type": "grapheme", "symbol": "ar", "displayName": "The AR sound", "transliteration": "ar", "soundHint": "/ɑːr/", "speechCue": "A R says ar, as in car. Car, star, farm.", "exampleWords": ["car", "star", "farm"] },
    { "id": "en-grapheme-or", "languageId": "en", "scriptId": "latin", "type": "grapheme", "symbol": "or", "displayName": "The OR sound", "transliteration": "or", "soundHint": "/ɔːr/", "speechCue": "O R says or, as in corn. Corn, fork, storm.", "exampleWords": ["corn", "fork", "storm"] },
    { "id": "en-grapheme-er", "languageId": "en", "scriptId": "latin", "type": "grapheme", "symbol": "er", "displayName": "The ER sound", "transliteration": "er", "soundHint": "/ɜːr/", "speechCue": "E R says er, as in her. Her, fern, term.", "exampleWords": ["her", "fern", "term"] },
    { "id": "en-grapheme-ir", "languageId": "en", "scriptId": "latin", "type": "grapheme", "symbol": "ir", "displayName": "The IR sound", "transliteration": "er", "soundHint": "/ɜːr/", "speechCue": "I R says er, as in bird. Bird, girl, shirt.", "exampleWords": ["bird", "girl", "shirt"] },
    { "id": "en-grapheme-ur", "languageId": "en", "scriptId": "latin", "type": "grapheme", "symbol": "ur", "displayName": "The UR sound", "transliteration": "er", "soundHint": "/ɜːr/", "speechCue": "U R says er, as in turn. Turn, burn, purple.", "exampleWords": ["turn", "burn", "purple"] }
  ],
