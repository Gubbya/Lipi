# Copy this file to .env and replace placeholders with private values.
PORT=4100

MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority&appName=Lipi
MONGODB_DB=lipi

GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash

AI_API_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN
