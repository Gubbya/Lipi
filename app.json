{
  "expo": {
    "name": "Lipi",
    "slug": "lipi",
    "version": "1.7.0",
    "orientation": "portrait",
    "icon": "./assets/images/lipi-icon.png",
    "scheme": "lipi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/lipi-icon.png",
      "bundleIdentifier": "com.gubbya.lipi",
      "buildNumber": "9"
    },
    "android": {
      "package": "com.gubbya.lipi",
      "versionCode": 19,
      "adaptiveIcon": {
        "backgroundColor": "#FFF9EF",
        "foregroundImage": "./assets/images/lipi-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF9EF",
          "image": "./assets/images/lipi-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Lipi to record your voice for pronunciation practice.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-image",
      "expo-asset",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
