{
  "expo": {
    "name": "Lipi",
    "slug": "lipi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/lipi-icon.png",
    "scheme": "lipi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/lipi-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF9EF",
        "foregroundImage": "./assets/images/lipi-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF9EF",
          "image": "./assets/images/lipi-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-audio",
      "expo-image",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
