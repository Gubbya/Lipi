# Optional: preconfigure the mobile app instead of entering the server URL in Profile.
EXPO_PUBLIC_LIPI_API_URL=http://192.168.1.10:4100

# Optional: direct public audio origin, such as a Cloudflare R2 custom domain.
# When omitted, Lipi downloads from EXPO_PUBLIC_LIPI_API_URL/media/audio.
EXPO_PUBLIC_LIPI_ASSET_URL=
